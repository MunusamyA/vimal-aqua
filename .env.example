APP_ENV=development
APP_DEBUG=1
APP_NAME="PHP ERP Starter Kit"
APP_SHORT_NAME=ERP
APP_SUBTITLE="Business Management Platform"
APP_KEY=starterkit
APP_URL=http://localhost/php-erp-starter
APP_TIMEZONE=Asia/Kolkata
ALLOWED_ORIGINS=*

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=php_erp_starter
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4

# Generate once for each project/installation: openssl rand -hex 32
# Never replace this secret while issued tokens should remain valid.
TOKEN_SECRET=replace-with-at-least-32-random-characters
TOKEN_EXPIRY_HOURS=24

# Automatic logout after this many minutes with no real user activity.
IDLE_TIMEOUT_MINUTES=60

# Generate once: openssl rand -base64 32. Never change after encrypting data.
APP_ENCRYPTION_KEY=replace-with-a-fixed-base64-encoded-32-byte-key
# SMTP host/user/password are configured from Administration -> Mail Configuration.
# The SMTP password is encrypted with APP_ENCRYPTION_KEY before database storage.

UPLOAD_PATH=
UPLOAD_BASE_URL=
UPLOAD_MAX_IMAGE_MB=10
UPLOAD_MAX_VIDEO_MB=50
